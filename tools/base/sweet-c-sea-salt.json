  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7A8696",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#AE9B7F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags (@brief @param)",
      "scope": [
        "storage.type.class.doxygen",
        "storage.type.class.jsdoc",
        "punctuation.definition.keyword.doxygen",
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#75CCC4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings & chars (emerald)",
      "scope": [
        "string",
        "string.quoted.other.lt-gt.include"
      ],
      "settings": {
        "foreground": "#75C290",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#CB8871",
        "fontStyle": ""
      }
    },
    {
      "name": "printf specifiers (hazard: type must match)",
      "scope": [
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#E2726B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Format placeholders / template exprs",
      "scope": [
        "constant.character.format.placeholder",
        "storage.type.format",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#E2726B",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers & literal constants (gold)",
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.other.enummember",
        "constant.other.color",
        "constant.other.caps"
      ],
      "settings": {
        "foreground": "#D5C984",
        "fontStyle": ""
      }
    },
    {
      "name": "Number prefix/suffix (0x, UL, f)",
      "scope": [
        "keyword.other.unit",
        "storage.type.number"
      ],
      "settings": {
        "foreground": "#AEA581",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords & control flow (amber)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.cast",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.operator.ternary",
        "keyword.operator.wordlike",
        "keyword.other.operator.overload",
        "storage.type.function",
        "storage.type.js",
        "storage.type.ts",
        "storage.type.jsx",
        "storage.type.tsx"
      ],
      "settings": {
        "foreground": "#E59B5B",
        "fontStyle": ""
      }
    },
    {
      "name": "Compile-time keywords (typedef sizeof alignof)",
      "scope": [
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.alignas",
        "keyword.other.typedef",
        "storage.type.typedef"
      ],
      "settings": {
        "foreground": "#E59B5B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Quiet operators (arith, compare, assign, ++)",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "punctuation.separator.dot-access",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#8A939E",
        "fontStyle": ""
      }
    },
    {
      "name": "Bit ops & shifts (coral = touches bits)",
      "scope": [
        "keyword.operator.bitwise",
        "keyword.operator.assignment.compound.bitwise"
      ],
      "settings": {
        "foreground": "#E2726B",
        "fontStyle": ""
      }
    },
    {
      "name": "Pointer/ref declarators",
      "scope": [
        "storage.modifier.pointer",
        "storage.modifier.reference",
        "punctuation.definition.pointer",
        "punctuation.definition.reference",
        "keyword.operator.address",
        "keyword.operator.dereference"
      ],
      "settings": {
        "foreground": "#E2726B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Arrow ->",
      "scope": [
        "punctuation.separator.pointer-access",
        "punctuation.accessor.arrow"
      ],
      "settings": {
        "foreground": "#E2726B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Scope resolution ::",
      "scope": [
        "punctuation.separator.scope-resolution",
        "punctuation.separator.namespace"
      ],
      "settings": {
        "foreground": "#6F9895",
        "fontStyle": ""
      }
    },
    {
      "name": "Primitive & library types (sky)",
      "scope": [
        "storage.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#5EA0CD",
        "fontStyle": ""
      }
    },
    {
      "name": "Composite-type keywords & user types (turquoise)",
      "scope": [
        "storage.type.struct",
        "storage.type.union",
        "storage.type.enum",
        "storage.type.class",
        "storage.type.namespace",
        "storage.type.template",
        "storage.type.template.argument",
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.union",
        "entity.name.enum",
        "entity.other.inherited-class",
        "support.type.posix-reserved"
      ],
      "settings": {
        "foreground": "#75CCC4",
        "fontStyle": ""
      }
    },
    {
      "name": "Qualifiers (const volatile static extern inline, public:)",
      "scope": [
        "storage.modifier",
        "storage.type.modifier"
      ],
      "settings": {
        "foreground": "#9CADCB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Empty array brackets [] (C grammar scopes them as storage.modifier)",
      "scope": [
        "storage.modifier.array"
      ],
      "settings": {
        "foreground": "#7DABB0",
        "fontStyle": ""
      }
    },
    {
      "name": "volatile (C++ only; C grammar has no scope for it)",
      "scope": [
        "storage.modifier.specifier.volatile"
      ],
      "settings": {
        "foreground": "#E2726B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions (iris)",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "entity.name.label",
        "entity.name.operator",
        "entity.name.command"
      ],
      "settings": {
        "foreground": "#B5A4FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Library / builtin functions",
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#8D96BE",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#C6CDD4",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "variable.language.special.self",
        "variable.language.special.cls"
      ],
      "settings": {
        "foreground": "#C2B7DB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Members / keys / properties",
      "scope": [
        "variable.other.member",
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "punctuation.support.type.property-name",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "keyword.other.definition.ini",
        "punctuation.definition.begin.bracket.square",
        "punctuation.definition.end.bracket.square",
        "support.variable.magic"
      ],
      "settings": {
        "foreground": "#7DABB0",
        "fontStyle": ""
      }
    },
    {
      "name": "this / self-like language variables, registers",
      "scope": [
        "variable.language",
        "variable.other.register",
        "support.constant.register",
        "storage.type.register"
      ],
      "settings": {
        "foreground": "#E2726B",
        "fontStyle": ""
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "punctuation.definition.directive",
        "entity.other.attribute-name.pragma",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#AB81AD",
        "fontStyle": ""
      }
    },
    {
      "name": "Macro names & macro parameters",
      "scope": [
        "entity.name.function.preprocessor",
        "entity.name.other.preprocessor.macro",
        "variable.other.macro",
        "variable.parameter.preprocessor"
      ],
      "settings": {
        "foreground": "#E497CE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Macro parameter-list parens (tinted)",
      "scope": [
        "meta.preprocessor.macro punctuation.definition.parameters",
        "meta.preprocessor punctuation.section.parameters"
      ],
      "settings": {
        "foreground": "#AB81AD",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation ; , : { }",
      "scope": [
        "punctuation",
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments"
      ],
      "settings": {
        "foreground": "#6A727D",
        "fontStyle": ""
      }
    },
    {
      "name": "Assembly (extension-dependent)",
      "scope": [
        "support.function.mnemonic",
        "keyword.other.mnemonic",
        "entity.name.function.mnemonic",
