@ asm.directive directive .syntax L1
@ asm.section.directive directive .section L2
@ asm.global directive .global L3
@ asm.label.def function Reset_Handler L5
@ asm.mnemonic keyword ldr L6
@ asm.register hazard r0 L6
@ asm.symbol.ref globalvar _estack L6
@ asm.register.sp hazard sp L7
@ asm.mnemonic.s keyword movs L8
@ asm.immediate.hash number # L8
@ asm.immediate number ~0x10 L8
@ asm.branch.call keyword bl L10
@ asm.call.target function main L10
@ asm.condition keyword bne L12
@ asm.label.ref function Reset_Handler L12
@ asm.mem.bracket punct [ L13
@ asm.word.value number 0xDEADBEEF L15
@ asm.comment comment comment L16
@ asm.comment.block comment block L17
@ asm.cpu directive .cpu L18
@ asm.equ directive .equ L19
@ asm.equ.name globalvar STACK L19
@ asm.ifdef directive .ifdef L20
@ asm.push keyword push L22
@ asm.reglist.brace punct { L22
@ asm.ldm keyword ldmia L23
@ asm.writeback hazard ! L23
@ asm.bin.number number ~0b1010 L24
@ asm.char string ~'A' L25
@ asm.ascii.string string text L26
@ asm.pc hazard pc L27
