      {
        "label": "Rosin · Matcha",
        "uiTheme": "vs-dark",
        "path": "./themes/rosin-matcha.json"
      },
      {
        "label": "Rosin · Espresso",
        "uiTheme": "vs-dark",
        "path": "./themes/rosin-espresso.json"
      },
      {
        "label": "Rosin · Licorice",
        "uiTheme": "vs-dark",
        "path": "./themes/rosin-licorice.json"
      },
      {
        "label": "Rosin · OLED",
        "uiTheme": "vs-dark",
        "path": "./themes/rosin-oled.json"
